#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
tool="$project_dir/tools/opensta/sta"
if [[ ! -x "$tool" ]]; then
    echo "OpenSTA not found: $tool" >&2
    exit 2
fi
cd "$project_dir"

if [[ "$(uname -s)" == Darwin ]]; then
    exec orb -m "${OPENSTA_VM:-ubuntu24}" -w "$project_dir" "$tool" "$@"
fi
exec "$tool" "$@"
